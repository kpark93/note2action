# Runtime connection: the LOW-PRIVILEGE app role. Never the postgres
# superuser — superusers and table owners bypass Row-Level Security.
DATABASE_URL=postgresql+psycopg://note2action_app:note2action_app_dev@localhost:5432/note2action
# Migrations run as the admin role (DDL powers the app role lacks).
MIGRATIONS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/note2action
REPOSITORY=postgres
# From Clerk dashboard -> API Keys -> JWKS URL (public keys; not a secret)
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
