# Anthropic API key for the Vercel AI SDK provider.
# Get one at https://console.anthropic.com/ then copy this file to `.env`:
#   cp .env.example .env
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model used for note extraction (defaults to the fast
# claude-haiku-4-5). Bump to a larger model to trade speed for quality.
# EXTRACT_MODEL=claude-haiku-4-5

# Clerk JWKS URL (dashboard → API Keys → JWKS URL) — same value as
# apps/api/.env. Unset = auth bypass: every extract request is accepted.
CLERK_JWKS_URL=
